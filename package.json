{
  "name": "ring-routine-sim",
  "version": "0.1.0",
  "description": "Generate weeks of realistic Ring-shaped household events with injectable drift, and replay them to any webhook with valid HMAC signatures.",
  "keywords": ["ring", "amazon-vision", "webhook", "simulator", "hmac", "caregiving", "testing"],
  "author": "Gregory Temwa Odete",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/youneedgreg/ring-routine-sim.git" },
  "homepage": "https://github.com/youneedgreg/ring-routine-sim#readme",
  "bugs": "https://github.com/youneedgreg/ring-routine-sim/issues",
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "bin": { "ring-routine-sim": "./dist/cli.js" },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] }
}
